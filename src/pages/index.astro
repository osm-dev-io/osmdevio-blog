---
import { getCollection } from 'astro:content';
import WritingItem from '../components/WritingItem.astro';
import { SITE_TITLE } from '../consts';
import SiteLayout from '../layouts/SiteLayout.astro';

const writings = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<SiteLayout>
	<div class="flex flex-col gap-9">
		<div class="flex flex-col gap-5">
			<h1 class="text-[min(12vw,72px)] leading-[0.9] tracking-[-2px] sm:tracking-[-4px]">
				{SITE_TITLE}
				<span lang="ko" class="block text-[var(--color-text-secondary)]">개발 블로그</span>
			</h1>
			<p lang="ko" class="type-body">소프트웨어를 만들며 배운 것과 짧은 메모를 남깁니다.</p>
		</div>

		{writings.length > 0 && (
			<section aria-labelledby="recent-writings" class="flex flex-col gap-3">
				<div class="flex items-baseline justify-between gap-3">
					<h2 id="recent-writings" class="type-section">recent writings</h2>
					<a href="/blog/" class="type-meta shrink-0 hover:underline">all writings</a>
				</div>
				<ul class="flex flex-col gap-2">
					{writings.map((post) => <li><WritingItem post={post} /></li>)}
				</ul>
			</section>
		)}
	</div>
</SiteLayout>
