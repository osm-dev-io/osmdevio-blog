---
import { getCollection } from 'astro:content';
import WritingItem from '../../components/WritingItem.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const writings = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<SiteLayout title="writings" description="Long-form posts from osmdevio.">
	<div class="flex flex-col gap-6">
		<h1 class="type-page-title">writings</h1>
		{writings.length === 0 ? (
			<p class="type-body">No writings yet.</p>
		) : (
			<ul class="flex flex-col gap-3">
				{writings.map((post) => <li><WritingItem post={post} /></li>)}
			</ul>
		)}
	</div>
</SiteLayout>
