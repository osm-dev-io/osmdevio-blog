<button
	type="button"
	id="theme-toggle"
	aria-label="Dark mode"
	aria-pressed="false"
	class="rounded-full p-2 text-[var(--color-text-secondary)] transition-colors hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-text)]"
>
	<svg class="hidden size-[18px] dark:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0z" />
	</svg>
	<svg class="size-[18px] dark:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M20.5 13.5A8.5 8.5 0 0 1 10.5 3.5a8.5 8.5 0 1 0 10 10Z" />
	</svg>
</button>

<script>
	const button = document.getElementById('theme-toggle');
	const root = document.documentElement;
	button?.setAttribute('aria-pressed', String(root.classList.contains('dark')));

	button?.addEventListener('click', () => {
		const isDark = root.classList.toggle('dark');
		button.setAttribute('aria-pressed', String(isDark));
		try {
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
		} catch {
			// The current page can still switch themes when storage is unavailable.
		}
	});
</script>
