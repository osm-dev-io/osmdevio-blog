---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FormattedDate from '../components/FormattedDate.astro';
import SiteLayout from './SiteLayout.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	category?: string;
	showSummary?: boolean;
}

const { title, description, pubDate, updatedDate, heroImage, category, showSummary = true } = Astro.props;
---

<SiteLayout title={title} description={description} image={heroImage} type="article">
	<article class="flex flex-col gap-6">
		<header class="flex flex-col gap-3">
			<h1 class="type-page-title">{title}</h1>
			<div class="type-meta flex flex-wrap items-center gap-x-2 gap-y-1">
				<FormattedDate date={pubDate} />
				{updatedDate && <span>· updated <FormattedDate date={updatedDate} /></span>}
				{category && <span>· {category}</span>}
			</div>
		</header>

		{showSummary && <p class="type-lede">{description}</p>}
		{heroImage && (
			<Image src={heroImage} width={960} alt="" class="h-auto w-full rounded-lg" fetchpriority="high" />
		)}
		<div class="prose w-full max-w-none break-words prose-headings:font-medium prose-a:decoration-orange-500 prose-img:rounded-lg dark:prose-invert md:prose-lg">
			<slot />
		</div>
	</article>
</SiteLayout>
